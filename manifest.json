{
  "manifest_version": 3,
  "name": "Vinted NL/BE-filter",
  "version": "0.3.0",
  "description": "Toont op Vinted alleen artikelen van verkopers uit Nederland en België (instelbaar).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vinted NL/BE-filter",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.vinted.nl/*",
    "https://www.vinted.be/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.vinted.nl/*", "https://www.vinted.be/*"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.vinted.nl/*", "https://www.vinted.be/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vinted-nl-be-filter@wietsedejong",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
